{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trame",
  "version": "0.1.0",
  "identifier": "com.leo.trame",
  "build": {
    "beforeDevCommand": "deno task dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "deno task build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Trame",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEMURDMjRDOEM3QTY0MTkKUldRWlpIcU1UTUlkYmFIbVh6akF1VGFIYk93MFVDZEsyVTJGbzVad1N1MVRvQmh5ckI4aWs0MzMK",
      "endpoints": [
        "https://github.com/LeoMartinDev/trame/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
