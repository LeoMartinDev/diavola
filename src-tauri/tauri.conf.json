{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diavola",
  "version": "0.2.4",
  "identifier": "com.leo.diavola",
  "build": {
    "beforeDevCommand": "deno task dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "deno task build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Diavola",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzRjA5MDk4NEIzMDgwOTUKUldTVmdEQkxtSkR3czdnb0tGN0IrcUNNMWNrdmdERldCaE1pUVJ1WXBUOEZGc0w3SzhESkdITFYK",
      "endpoints": [
        "https://github.com/LeoMartinDev/diavola/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
